<!doctype html>
<html lang="{{ site.lang }}" class="lab-home">
  <head>
    {% include head.liquid %}
  </head>

  <body>
    <div class="lab-scroll-root">

      <div class="lab-hero">
        {% if page.ko %}
        <a class="lab-hero-lang-btn" href="{{ '/' | relative_url }}">English</a>
        {% else %}
        <a class="lab-hero-lang-btn" href="{{ '/ko/' | relative_url }}">한국어</a>
        {% endif %}
        <div class="lab-hero-image">
          <img src="{{ '/assets/img/ample_main.png' | relative_url }}" alt="{{ site.title }}">
        </div>
        <div class="lab-hero-panel">
          <div class="lab-hero-content">
            {% if page.ko %}
            <div class="lab-hero-label">경북대학교</div>
            <h1 class="lab-hero-title">기후과학연구실</h1>
            <div class="lab-hero-subtitle">{{ site.title }}</div>
            {% else %}
            <div class="lab-hero-label">Kyungpook National University</div>
            <h1 class="lab-hero-title">{{ site.title }}</h1>
            <div class="lab-hero-subtitle">기후과학연구실</div>
            {% endif %}
            <div class="lab-hero-desc">{{ content }}</div>
            <div class="lab-hero-links">
              {% if page.ko %}
              <a href="{{ '/members/prof-ko/' | relative_url }}">교수 <span style="font-size:0.65em;">▶</span></a>
              <a href="{{ '/members-ko/' | relative_url }}">연구원 <span style="font-size:0.65em;">▶</span></a>
              <a href="{{ '/publications-ko/' | relative_url }}">연구 논문 <span style="font-size:0.65em;">▶</span></a>
              {% else %}
              <a href="{{ '/members/prof/' | relative_url }}">Professor <span style="font-size:0.65em;">▶</span></a>
              <a href="{{ '/members/' | relative_url }}">Members <span style="font-size:0.65em;">▶</span></a>
              <a href="{{ '/publications/' | relative_url }}">Publications <span style="font-size:0.65em;">▶</span></a>
              {% endif %}
            </div>
            <div class="lab-hero-address">
              <img src="{{ '/assets/img/15-1.svg' | relative_url }}" alt="KNU Logo">
              {% if page.ko %}
              경북대학교 지리학과<br>
              대구광역시 북구 대학로 80 (우: 41566)<br>
              Tel: 053-950-5233
              {% else %}
              Department of Geography, Kyungpook National University<br>
              80 Daehak-ro, Buk-gu, Daegu 41566, South Korea<br>
              Tel: +82-53-950-5233
              {% endif %}
            </div>
          </div>
        </div>
      </div>




      <div class="lab-second-section">
        <div class="container lab-below-hero">
          <div class="lab-section-header">
            {% if page.ko %}
            <h2>최근 논문</h2>
            <a href="{{ '/publications-ko/' | relative_url }}" class="lab-all-link">전체 보기 &rarr;</a>
            {% else %}
            <h2>Recent Publications</h2>
            <a href="{{ '/publications/' | relative_url }}" class="lab-all-link">All &rarr;</a>
            {% endif %}
          </div>
          {% include recent_papers.liquid %}
        </div>

        {% include footer.liquid %}
      </div>

    </div>

    {% include scripts.liquid %}
    <script>
      (function () {
        var root = document.querySelector(".lab-scroll-root");
        if (!root) return;
        var hero = root.querySelector(".lab-hero");
        var scrolling = false;
        var duration = 900; // ms — 길수록 느리고 부드럽게

        function ease(t) {
          // ease-in-out cubic
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function goTo(target) {
          if (scrolling) return;
          scrolling = true;
          var start = root.scrollTop;
          var change = target - start;
          var startTime = null;

          function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            root.scrollTop = start + change * ease(progress);
            if (progress < 1) {
              requestAnimationFrame(step);
            } else {
              scrolling = false;
            }
          }
          requestAnimationFrame(step);
        }

        root.addEventListener(
          "wheel",
          function (e) {
            e.preventDefault();
            var heroH = hero.offsetHeight;
            var cur = root.scrollTop;
            if (e.deltaY > 0 && cur < heroH - 10) {
              goTo(heroH);
            } else if (e.deltaY < 0 && cur > 10) {
              goTo(0);
            }
          },
          { passive: false }
        );

        var touchStartY = 0;
        root.addEventListener(
          "touchstart",
          function (e) {
            touchStartY = e.touches[0].clientY;
          },
          { passive: true }
        );
        root.addEventListener(
          "touchend",
          function (e) {
            var diff = touchStartY - e.changedTouches[0].clientY;
            if (Math.abs(diff) < 30) return;
            goTo(diff > 0 ? hero.offsetHeight : 0);
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
